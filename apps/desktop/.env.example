# Copie para .env.production.local (fica fora do git) antes de gerar instaladores no seu computador.
# Endereço da API do Pregar na Railway, embutido no app.
MAIN_VITE_PREGAR_API_URL=https://api.seu-dominio.com.br
# Cliente OAuth "App para computador" do Google Drive (docs/google-drive-setup.md). Opcional.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
# Chave da Drive API para importar pastas públicas. Opcional.
MAIN_VITE_DRIVE_API_KEY=
