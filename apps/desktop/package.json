{
  "name": "@pregar/desktop",
  "productName": "Pregar",
  "desktopName": "pregar.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pregar para Windows, macOS e Linux.",
  "author": "Caminho Anglicano",
  "homepage": "https://caminhoanglicano.com.br",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false --emitDeclarationOnly false && vue-tsc --noEmit -p tsconfig.web.json --composite false --emitDeclarationOnly false",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "e2e": "node test/e2e/run-all.mjs out screenshots",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@pregar/core": "0.1.0",
    "@pregar/editor": "0.1.0",
    "@tiptap/vue-3": "^3.32.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^3.0.4",
    "tesseract.js": "^7.0.0",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.14"
  }
}
