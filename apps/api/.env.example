# Copie para .env em desenvolvimento. Na Railway, cadastre em Variables.
# Em desenvolvimento use NODE_ENV=development (o código de login aparece no log).
NODE_ENV=production
# A Railway injeta PORT; o servidor escuta em 0.0.0.0.
PUBLIC_BASE_URL=https://api.seu-dominio.com.br
# Referência ao Postgres da Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://usuario:senha@host:5432/pregar
DATABASE_SSL=false
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# Email do código de login (https://resend.com). Sem chave, o código só aparece no log.
RESEND_API_KEY=
EMAIL_FROM=Pregar <nao-responda@seu-dominio.com.br>

# Estêvão API: chave do servidor usada pelos assinantes.
ESTEVAO_API_KEY=
ESTEVAO_PROXY_FOR_FREE=false

# Provedores de IA usados pelos assinantes.
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
AI_REVIEW_PROVIDER=anthropic
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_RESEARCH_PROVIDER=perplexity
AI_RESEARCH_MODEL=perplexity/sonar

# Asaas: chave da conta, ambiente e token escolhido ao cadastrar o webhook.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=
# pix_automatico exige conta PJ elegível; pix_assinatura funciona em qualquer conta.
BILLING_PIX_MODE=pix_assinatura
PLAN_MONTHLY_PRICE_CENTS=1990
PLAN_YEARLY_PRICE_CENTS=19900
BILLING_GRACE_DAYS=5

# Limites do plano pago.
LIMIT_REVIEWS_PER_MONTH=40
LIMIT_STRUCTURE_PER_MONTH=40
LIMIT_QUESTIONS_PER_MONTH=60
LIMIT_RESEARCH_PER_MONTH=60
LIMIT_AI_CALLS_PER_DAY=20
LIMIT_MONTHLY_COST_USD=8
LIMIT_ESTEVAO_PER_MINUTE=120

# Suporte: rotas /v1/admin (gere com openssl rand -base64 48). Deixe vazio para desligar.
ADMIN_TOKEN=

# Páginas legais (/legal/privacidade e /legal/termos).
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_DOCUMENT=
LEGAL_CONTACT_EMAIL=
