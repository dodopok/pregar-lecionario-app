{
  "name": "@pregar/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Pregar: contas, assinatura com Pix (Asaas), proxy de IA com cotas e proxy da Estêvão API.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/migrate.ts",
    "admin": "tsx --env-file-if-exists=.env src/admin.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@pregar/core": "0.1.0",
    "fastify": "^5.12.7",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
